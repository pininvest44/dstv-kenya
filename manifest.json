{
  "manifest_version": 3,
  "name": "CSP Fetch Proxy",
  "version": "1.0",
  "permissions": [],
  "host_permissions": [
    "https://dstv-kenya.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
