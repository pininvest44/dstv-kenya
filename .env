# Server Configuration
PORT=3000

# PalPluss API Configuration
PALPLUSS_AUTH_HEADER=Basic <encoded-value>
PALPLUSS_CHANNEL_ID=your-payment-channel-id

# Webhook Callback URL (Must be publicly accessible, e.g., via Ngrok for local testing or your live domain)
CALLBACK_URL=https://yourserver.com/webhooks/mpesa
